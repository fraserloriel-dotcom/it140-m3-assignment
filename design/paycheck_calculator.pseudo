// Program Name: Paycheck Calculator
// Description: Calculates gross pay including overtime for hours worked over 40.

// Declare variables
DECLARE hours_worked AS FLOAT
DECLARE hourly_wage AS FLOAT
DECLARE gross_pay AS FLOAT
DECLARE regular_pay AS FLOAT
DECLARE overtime_hours AS FLOAT
DECLARE overtime_pay AS FLOAT

// Prompt user for inputs
PRINT "Enter total hours worked:"
INPUT hours_worked

PRINT "Enter hourly wage:"
INPUT hourly_wage

// Check for overtime and calculate gross pay
IF hours_worked > 40 THEN
    regular_pay = 40 * hourly_wage
    overtime_hours = hours_worked - 40
    overtime_pay = overtime_hours * (hourly_wage * 1.5)
    gross_pay = regular_pay + overtime_pay
ELSE
    gross_pay = hours_worked * hourly_wage
ENDIF

// Display final result
PRINT "Your total gross pay is: $" + gross_pay
